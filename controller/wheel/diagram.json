  "connections": [
    ["steering:VCC", "esp:3V3", "red", []],
    ["steering:GND", "esp:GND.1", "black", []],
    ["steering:SIG", "esp:34", "green", []],

    ["throttle:1.l", "esp:25", "green", []],
    ["throttle:2.l", "esp:GND.1", "black", []],

    ["brake:1.l", "esp:26", "green", []],
    ["brake:2.l", "esp:GND.1", "black", []],

    ["item:1.l", "esp:27", "green", []],
    ["item:2.l", "esp:GND.1", "black", []],

    ["esp:2", "ledResistor:1", "green", []],
    ["ledResistor:2", "feedbackLed:A", "green", []],
    ["feedbackLed:C", "esp:GND.1", "black", []],

    ["buzzer:1", "esp:GND.1", "black", []],
    ["buzzer:2", "esp:18", "green", []]
