        "key": "W"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "brake",
      "top": 230,
      "left": 280,
      "attrs": {
        "color": "red",
        "label": "BRAKE",
        "key": "S"
      }
    },
    {
      "type": "wokwi-pushbutton",
